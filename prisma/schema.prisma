generator client {
  provider = "prisma-client"
  output   = "../prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id            Int             @id
  events        Events[]
  microservices Microservices[]
}

model Events {
  id            Int             @id @default(autoincrement())
  keyWord       String
  userId        Int
  user          Users           @relation(fields: [userId], references: [id])
  microservices Microservices[] @relation("EventsToMicroservices")

  @@unique([userId, keyWord])
}

model Microservices {
  id     Int      @id @default(autoincrement())
  name   String
  secret String
  userId Int
  user   Users    @relation(fields: [userId], references: [id])
  events Events[] @relation("EventsToMicroservices")

  @@unique([userId, name])
  @@unique([name, secret])
}
